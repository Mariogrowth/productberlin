{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productberlin-local",
  "main": "api-worker/entry.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "webApp/build/dist/js/productionExecutable",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "productberlin-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "BUILD_SHA": "local",
    "BRANDFETCH_CLIENT_ID": "1idVlgkCIW8K520_bqV",
    "BREVO_LIST_ID": "3",
    "BREVO_DOI_TEMPLATE_ID": "1"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 6 * * MON"
    ]
  }
}
