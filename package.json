{
  "name": "productberlin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm run build && node scripts/local-dev.mjs",
    "dev": "node scripts/local-dev.mjs --serve-only",
    "dev:web": "./gradlew :webApp:jsBrowserDevelopmentRun --continuous",
    "build": "./gradlew :api-worker:jsNodeProductionLibraryDistribution :webApp:jsBrowserDistribution",
    "test": "./gradlew allTests",
    "test:integration": "node --test scripts/test/cloudflare.test.mjs scripts/test/collector.test.mjs scripts/test/rss-parser.test.mjs scripts/test/collect-news.test.mjs scripts/test/collect-jobs.test.mjs",
    "test:dev": "node --test scripts/test/local-dev.test.mjs",
    "check": "npm run lint && npm run test:deployment && npm test && npm run build && npm run test:integration && npm run test:dev",
    "lint": "./gradlew ktlintCheck",
    "format": "./gradlew ktlintFormat",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/cloudflare.mjs seed local",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "cf": "node scripts/cloudflare.mjs",
    "test:deployment": "node --test scripts/test/deployment.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "miniflare": "5.20260918.0-alpha",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1"
  }
}
