# Gradle / Kotlin caches and generated module outputs
.gradle/
.kotlin/
build/
dist/

# Installed JavaScript dependencies and local package-manager caches / logs
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Wrangler cache, local D1 databases, generated seeds and deployment configs
.wrangler/
/cloudflare/.generated/

# Local environment values and credentials; sanitized examples may be committed
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example
!.env.*.example
!.dev.vars.example
!.dev.vars.*.example
local.properties

# Test output outside Gradle build directories
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/blob-report/

# Local IDE state and editor backups (shared .run configurations stay tracked)
.idea/
*.iml
*.iws
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Keep package-lock.json, kotlin-js-store/yarn.lock, the Gradle wrapper,
# wrangler.json, SQL migrations, mock fixtures and GitHub workflows in Git.
